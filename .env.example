EXPO_PUBLIC_WORKER_PORTAL_URL=https://your-worker-portal.example
EXPO_PUBLIC_CLIENT_SHARE_URL=https://your-client-portal.example
EXPO_PUBLIC_DIARY_APPROVAL_URL=https://your-worker-portal.example/approve
EXPO_PUBLIC_SUPPLIER_QUOTE_URL=https://your-worker-portal.example/quote

# Optional EAS project identifier for cloud builds.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Public browser credentials used only when building the worker portal.
WORKER_PORTAL_SUPABASE_URL=https://your-project.supabase.co
WORKER_PORTAL_SUPABASE_ANON_KEY=your-public-anon-key
VAPID_PUBLIC_KEY=your-public-vapid-key

# Server-side Worker variable. Configure it in the hosting environment.
