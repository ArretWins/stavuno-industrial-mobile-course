EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_PASSWORD_RECOVERY_URL=https://your-worker-portal.example/reset-password
EXPO_PUBLIC_APP_UPDATE_MANIFEST_URL=https://your-worker-portal.example/app-version.json
EXPO_PUBLIC_APK_DOWNLOAD_HOST=your-project.supabase.co

# Public URLs of the optional web portals used by the mobile client.
